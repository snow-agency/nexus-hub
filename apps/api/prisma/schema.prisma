// Schéma de base de données du noyau Nexus Hub
// Ce schéma couvre uniquement le noyau (V1) : authentification, projet minimal,
// tâches minimales, finances minimales, moteur de règles et Next Action.
// Les champs et modèles du V1.5 (Business Model Canvas, catégories avancées,
// équipe, mentorat...) seront ajoutés par migration une fois le noyau validé.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Utilisateur
// ---------------------------------------------------------------------------
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  createdAt    DateTime  @default(now()) @map("created_at")

  projects     Project[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Phase du projet dans le parcours entrepreneur (cahier des charges, section 4)
// ---------------------------------------------------------------------------
enum ProjectPhase {
  IDEE_VALIDATION
  LANCEMENT
  CROISSANCE
}

// ---------------------------------------------------------------------------
// Projet (version minimale du noyau)
// ---------------------------------------------------------------------------
model Project {
  id          String        @id @default(uuid())
  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  sector      String
  country     String
  phase       ProjectPhase  @default(IDEE_VALIDATION)
  budgetTotal Decimal       @map("budget_total") @db.Decimal(12, 2)
  objective   String?

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tasks         Task[]
  transactions  Transaction[]
  signals       Signal[]
  nextActions   NextAction[]
  strategyItems StrategyItem[]
  teamMembers   TeamMember[]
  contacts      Contact[]
  opportunities Opportunity[]
  goals         Goal[]
  bmcBlocks     BmcBlock[]
  proposals     Proposal[]
  chatMessages  ChatMessage[]

  @@map("projects")
}

// ---------------------------------------------------------------------------
// Tâche (version minimale : à faire / fait)
// ---------------------------------------------------------------------------
enum TaskStatus {
  A_FAIRE
  FAIT
}

model Task {
  id        String     @id @default(uuid())
  projectId String     @map("project_id")
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title     String
  status    TaskStatus @default(A_FAIRE)
  dueDate   DateTime?  @map("due_date")

  assigneeId String?     @map("assignee_id")
  assignee   TeamMember? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt DateTime   @default(now()) @map("created_at")

  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Transaction financière (version minimale : dépense ou revenu)
// ---------------------------------------------------------------------------
enum TransactionType {
  DEPENSE
  REVENU
}

enum TransactionCategory {
  MARKETING
  DEVELOPPEMENT
  LOGISTIQUE
  SALAIRES
  LOYER
  MATERIEL
  ADMINISTRATIF
  AUTRE
}

model Transaction {
  id        String          @id @default(uuid())
  projectId String          @map("project_id")
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type      TransactionType
  amount    Decimal         @db.Decimal(12, 2)
  category  TransactionCategory?  @default(AUTRE)
  date      DateTime

  createdAt DateTime        @default(now()) @map("created_at")

  @@map("transactions")
}

// ---------------------------------------------------------------------------
// Signal détecté par le moteur de règles (cahier des charges, section 7.1)
//
// Le noyau (V1) ne détecte que ce que ses propres données permettent de
// vérifier : un budget dépassé (table Transaction) et une tâche en retard
// (table Task). Trois règles prévues dans la réflexion initiale sont
// volontairement reportées, faute de données pour les alimenter en V1 :
//   - objectif du mois non atteint : nécessite un objectif mensuel structuré,
//     qui n'existe pas encore dans Project (V1.5).
//   - tâche bloquée / inactivité prolongée : nécessite un module Organisation
//     plus avancé que la simple liste à faire / fait du noyau (V1.5).
//   - opportunité correspondant au secteur : nécessite le module Réseau,
//     qui n'est construit qu'en V2.
// ---------------------------------------------------------------------------
enum SignalType {
  BUDGET_DEPASSE
  TACHE_RETARD
}

enum SignalSeverity {
  HAUTE
  MOYENNE
  BASSE
}

model Signal {
  id         String         @id @default(uuid())
  projectId  String         @map("project_id")
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type       SignalType
  severity   SignalSeverity
  detectedAt DateTime       @default(now()) @map("detected_at")
  resolved   Boolean        @default(false)

  nextActions NextAction[]

  @@map("signals")
}

// ---------------------------------------------------------------------------
// Next Action (cahier des charges, section 6)
// Une NextAction peut naître d'un signal (signalId renseigné) ou être
// générée directement (ex. rappel d'onboarding).
// ---------------------------------------------------------------------------
enum NextActionStatus {
  PROPOSEE
  FAITE
  IGNOREE
}

model NextAction {
  id        String            @id @default(uuid())
  projectId String            @map("project_id")
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  signalId  String?           @map("signal_id")
  signal    Signal?           @relation(fields: [signalId], references: [id], onDelete: SetNull)

  title     String            // ex. "Valider ton étude de marché"
  reason    String            // pourquoi cette action est proposée
  dueDate   DateTime?         @map("due_date")
  impact    String?           // qualitatif, pas de chiffre inventé (voir section 6)
  status    NextActionStatus  @default(PROPOSEE)

  createdAt DateTime          @default(now()) @map("created_at")

  @@map("next_actions")
}
// ---------------------------------------------------------------------------
// V1.5 : stratégie, équipe, réseau, performance, Business Model Canvas
// ---------------------------------------------------------------------------
enum StrategyItemKind {
  ETAPE_MARCHE
  POSITIONNEMENT
  SECTION_PLAN
}

model StrategyItem {
  id        String           @id @default(uuid())
  projectId String           @map("project_id")
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind      StrategyItemKind
  title     String
  content   String?
  progress  Int              @default(0)
  done      Boolean          @default(false)
  position  Int              @default(0)

  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([projectId, kind])
  @@map("strategy_items")
}

model TeamMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name      String
  role      String
  email     String?

  tasks     Task[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@map("team_members")
}

enum ContactType {
  MENTOR
  PARTENAIRE
  INVESTISSEUR
  CLIENT
  FOURNISSEUR
  AUTRE
}

model Contact {
  id           String      @id @default(uuid())
  projectId    String      @map("project_id")
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name         String
  organization String?
  type         ContactType @default(AUTRE)
  email        String?
  phone        String?
  notes        String?

  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([projectId])
  @@map("contacts")
}

enum OpportunityKind {
  FINANCEMENT
  INCUBATION
  FORMATION
  EVENEMENT
  AUTRE
}

enum OpportunityStatus {
  A_EXPLORER
  EN_COURS
  OBTENUE
  ECARTEE
}

model Opportunity {
  id          String            @id @default(uuid())
  projectId   String            @map("project_id")
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?
  kind        OpportunityKind   @default(AUTRE)
  status      OpportunityStatus @default(A_EXPLORER)
  deadline    DateTime?
  url         String?
  aiSuggested Boolean           @default(false) @map("ai_suggested")

  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([projectId])
  @@map("opportunities")
}

model Goal {
  id        String    @id @default(uuid())
  projectId String    @map("project_id")
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title     String
  target    Float
  current   Float     @default(0)
  unit      String?
  deadline  DateTime?

  createdAt DateTime  @default(now()) @map("created_at")

  @@index([projectId])
  @@map("goals")
}

enum BmcBlockType {
  PROPOSITION_VALEUR
  SEGMENTS_CLIENTS
  CANAUX
  RELATIONS_CLIENTS
  REVENUS
  RESSOURCES_CLES
  ACTIVITES_CLES
  PARTENAIRES
  STRUCTURE_COUTS
}

model BmcBlock {
  id        String       @id @default(uuid())
  projectId String       @map("project_id")
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  block     BmcBlockType
  content   String

  updatedAt DateTime     @updatedAt @map("updated_at")

  @@unique([projectId, block])
  @@map("bmc_blocks")
}

// ---------------------------------------------------------------------------
// Agent IA : propositions automatiques et conversation
// ---------------------------------------------------------------------------
enum ProposalType {
  TACHE
  ETAPE_STRATEGIE
  POSITIONNEMENT
  OBJECTIF
  OPPORTUNITE
  BLOC_BMC
}

enum ProposalStatus {
  PROPOSEE
  ACCEPTEE
  REFUSEE
}

enum ProposalSource {
  AUTO
  CHAT
}

model Proposal {
  id        String         @id @default(uuid())
  projectId String         @map("project_id")
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type      ProposalType
  title     String
  reason    String
  payload   Json
  status    ProposalStatus @default(PROPOSEE)
  source    ProposalSource @default(AUTO)

  createdAt DateTime       @default(now()) @map("created_at")
  decidedAt DateTime?      @map("decided_at")

  @@index([projectId, status])
  @@map("proposals")
}

enum ChatRole {
  USER
  ASSISTANT
}

model ChatMessage {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  role      ChatRole
  content   String

  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@map("chat_messages")
}
