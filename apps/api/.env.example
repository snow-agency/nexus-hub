# Copier ce fichier en ".env" dans apps/api, puis remplir les valeurs.
# Le fichier .env ne doit jamais être envoyé sur GitHub.

PORT=3001

# Base de données (Supabase). La vraie valeur est donnée en privé par l'équipe.
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
# Sur Vercel, utiliser plutôt le pooler "Transaction" (port 6543) :
# DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Clé de signature des connexions. Mettre une longue chaîne aléatoire.
JWT_SECRET="remplacer_par_une_longue_chaine_aleatoire"

# IA pour Next Action (facultatif, une seule suffit)
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""